# SQLite apenas no computador. No Render, use PostgreSQL do Supabase.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/postgres?sslmode=require
BOOTSTRAP_LOGIN=suporte
# BOOTSTRAP_PASSWORD=defina_uma_senha_segura

# Recuperação de senha por e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
DB_STORAGE_LIMIT_MB=500
